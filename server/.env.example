PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Leave MONGO_URI empty to run with in-memory rule storage and console-only denial sink
MONGO_URI=mongodb://127.0.0.1:27017/ratelimiter
JWT_SECRET=change-me
NODE_ENV=development
# Must be the same on every instance. Falls back to a value derived from JWT_SECRET if empty.
IDENTITY_SECRET=
# Behind a reverse proxy, set to your proxy hop count (1) or addresses (10.0.0.0/8). "true" is refused.
TRUST_PROXY=
# Used only by the MongoDB integration tests (npm test)
MONGO_TEST_URI=mongodb://127.0.0.1:27017
# Dashboard hosted on another address (e.g. a Render static site): its exact origin, comma separated. No wildcard.
CORS_ORIGIN=
# Raise if Redis is in another region / a hosted service and the limiter reports bypassed requests.
LIMITER_TIMEOUT_MS=250
# Take the client IP from this header instead of req.ip (e.g. cf-connecting-ip on Render). Only set it if every
# request reaches the app through the proxy that sets it. Check /admin/whoami first.
CLIENT_IP_HEADER=
